# Supabase Configuration (client-visible — must be EXPO_PUBLIC_ prefixed)
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
# The anon key is a public, RLS-gated credential and is safe to ship in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Environment
NODE_ENV=development

# ----------------------------------------------------------------------------
# SERVER-SIDE SECRETS — DO NOT put these in the app / .env that ships to clients.
# Set them on Supabase instead (they are read by the analyze-memory Edge Function):
#   supabase secrets set OPENAI_API_KEY=sk-your-openai-api-key-here
#   supabase secrets set CRON_SECRET=<random-string-for-invoking-the-function>
# ----------------------------------------------------------------------------
