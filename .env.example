# Supabase Configuration (client-visible — must be EXPO_PUBLIC_ prefixed)
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
# The anon key is a public, RLS-gated credential and is safe to ship in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Environment
NODE_ENV=development

# ----------------------------------------------------------------------------
# SERVER-SIDE SECRETS — DO NOT put these in the app / .env that ships to clients.
# Set them on Supabase instead (Dashboard → Edge Functions → Secrets, or CLI):
#   supabase secrets set OPENAI_API_KEY=sk-your-openai-api-key-here
#
# OPENAI_API_KEY is read by BOTH Edge Functions:
#   - analyze-memory      (service-role + x-cron-secret; for the production cron path)
#   - process-my-memories (user-JWT scoped; invoked by the app after each capture)
#
# CRON_SECRET is only needed by analyze-memory (the cron path). The app's
# process-my-memories function authenticates with the caller's own JWT and needs
# no extra secret beyond OPENAI_API_KEY:
#   supabase secrets set CRON_SECRET=<random-string-for-invoking-analyze-memory>
# ----------------------------------------------------------------------------
